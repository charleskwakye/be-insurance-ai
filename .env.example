# Belgian MTPL Insurance ML Pipeline Configuration
# ================================================
# Copy this file to .env and modify values as needed before running the pipeline

# MLflow Configuration
# --------------------
# Set to True to delete all previous MLflow runs before training
# WARNING: This will permanently delete all experiment history
CLEAN_MLFLOW_RUNS=False
MLFLOW_EXPERIMENT_NAME=Belgian_MTPL_Severity

# Data Split Configuration
# ------------------------
# Fraction of data to use for testing (0.0 to 1.0)
TEST_SIZE=0.2
# Random seed for reproducibility
RANDOM_STATE=42

# XGBoost Basic Model Configuration
# ---------------------------------
XGBOOST_N_ESTIMATORS=1000
XGBOOST_LEARNING_RATE=0.05
XGBOOST_MAX_DEPTH=5
XGBOOST_EARLY_STOPPING_ROUNDS=50

# XGBoost Tuned Model Configuration
# ---------------------------------
# Number of random search iterations for hyperparameter tuning
RANDOM_SEARCH_N_ITER=50
RANDOM_SEARCH_CV_FOLDS=5

# Actuarial XGBoost Configuration
# -------------------------------
ACTUARIAL_N_ESTIMATORS=500
ACTUARIAL_LEARNING_RATE=0.1
ACTUARIAL_MAX_DEPTH=6
ACTUARIAL_SUBSAMPLE=0.8
ACTUARIAL_COLSAMPLE_BYTREE=0.8
ACTUARIAL_EARLY_STOPPING_ROUNDS=50

# Ridge/Lasso Regression Configuration
# ------------------------------------
RIDGE_ALPHA=1.0
LASSO_ALPHA=0.1

# Random Forest Configuration
# ---------------------------
RANDOM_FOREST_N_ESTIMATORS=200
RANDOM_FOREST_MAX_DEPTH=10

# Hugging Face Hub Configuration
# ------------------------------
# Set to True to upload the best model to Hugging Face Hub
UPLOAD_TO_HUB=True
# Your Hugging Face API token (get from https://huggingface.co/settings/tokens)
HF_TOKEN=your_huggingface_token_here
# Repository ID in format: username/repo-name
HF_REPO_ID=your-username/belgian-mtpl-insurance
